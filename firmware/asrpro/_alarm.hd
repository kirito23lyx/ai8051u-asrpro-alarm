<xml xmlns="http://www.w3.org/1999/xhtml"><block type="setup" id="setup0" x="100" y="-58"><statement name="DO"><block type="variables_declare" id="light_alarm_enable_decl"><field name="VAR">light_alarm_enable</field><field name="ioinput">uint8_t</field><next><block type="asr_speak" id="speak0"><field name="VOICE_SET">小英-高兴(V3)</field><field name="vol">8</field><field name="speed">8</field><next><block type="asr_welcom" id="wel0"><field name="NAME">陶品林哥哥你好，我是塔菲喵</field><next><block type="asr_sleep" id="sleep0"><field name="NAME">塔菲困了喵</field><next><block type="asr_id" id="wake0"><field name="ASR">你好塔菲</field><field name="leibie">唤醒词</field><field name="huifu">主人我在喵</field><field name="id">0</field><next><block type="asr_id" id="cmd1"><field name="ASR">设置闹钟</field><field name="leibie">命令词</field><field name="huifu">主人请设置闹钟喵</field><field name="id">1</field><next><block type="asr_id" id="cmd2"><field name="ASR">增加</field><field name="leibie">命令词</field><field name="huifu">增加成功喵</field><field name="id">2</field><next><block type="asr_id" id="cmd3"><field name="ASR">减少</field><field name="leibie">命令词</field><field name="huifu">减少成功喵</field><field name="id">3</field><next><block type="asr_id" id="cmd4"><field name="ASR">设置好了</field><field name="leibie">命令词</field><field name="huifu">好的喵，我会在准时叫醒主人</field><field name="id">4</field><next><block type="asr_id" id="cmd5"><field name="ASR">我起床了</field><field name="leibie">命令词</field><field name="huifu">太阳晒屁股了喵</field><field name="id">5</field><next><block type="asr_id" id="cmd6"><field name="ASR">现在几点</field><field name="leibie">命令词</field><field name="huifu">主人现在可以查看时间了喵</field><field name="id">6</field><next><block type="asr_id" id="cmd7"><field name="ASR">天亮叫我</field><field name="leibie">命令词</field><field name="huifu">好的主人</field><field name="id">7</field><next><block type="asr_id" id="#Dgj1$RTz$t?Y_ni#hJ6"><field name="ASR">原神</field><field name="leibie">命令词</field><field name="huifu">启动</field><field name="id">8</field><nex